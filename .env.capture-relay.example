# .env for the STANDALONE mcp-eveng-capture-relay service ONLY.
#
# This is a SEPARATE process from the main mcp-eveng server (its own
# systemd unit, its own venv, its own working directory -- see
# docs/capture-relay.md) and reads a SEPARATE .env file: copy this one to
# wherever mcp-eveng-capture-relay's own WorkingDirectory is (e.g.
# /opt/mcp-eveng-capture-relay/.env), NOT the same .env the main
# mcp-eveng process uses.
#
# This file intentionally does NOT contain:
#   - EVENG_* (the main process's EVE-NG application-API login --
#     the relay never talks to EVE-NG's REST API at all, only SSH)
#   - MCP_* (the relay isn't an MCP server -- it's a plain Starlette app)
#   - CAPTURE_RELAY_ADVERTISE_HOST/_PORT (only used by get_capture, in
#     the MAIN process's own .env.example -- the relay doesn't need to
#     know its own externally-advertised address, only what to bind to)
#   - CAPTURE_TOKEN_TTL_SECONDS / CAPTURE_SSH_TIMEOUT_SECONDS (both only
#     read by list_captures/get_capture in the main process; the relay
#     never issues tokens -- only verifies them -- and never runs a
#     bounded docker ps lookup, only the unbounded dumpcap stream)
# If you find any of those set here, they're being silently ignored, not
# used -- see CaptureSSHSettings/RelayListenSettings in
# src/mcp_eveng/capture_relay/config.py for exactly what each process
# actually reads.

# ---- SSH: the relay's OWN account, for `docker exec ... dumpcap` -------
# A DIFFERENT, MORE privileged account than list_captures'
# CAPTURE_SSH_USERNAME in the main process's .env.example -- this one
# needs docker exec rights, not just docker ps. See docs/capture-relay.md
# step 1-2 for creating this account and scoping its sudo rights
# separately from list_captures' account.
CAPTURE_SSH_HOST="172.16.130.14"
CAPTURE_SSH_PORT="22"
CAPTURE_SSH_USERNAME="mcp-eveng-capture-relay"
CAPTURE_SSH_KEY_PATH="/home/mcp-eveng-capture-relay/.ssh/id_ed25519"
# Set this for anything beyond a lab -- unset disables SSH host-key
# checking entirely.
# CAPTURE_SSH_KNOWN_HOSTS="/etc/mcp-eveng/known_hosts"

# ---- Token verification --------------------------------------------------
# MUST be the EXACT SAME value as CAPTURE_TOKEN_SECRET in the main
# mcp-eveng process's own .env (derived from .env.example) -- this is the
# shared HMAC secret get_capture signs with and this relay verifies
# against. Generate once with `openssl rand -hex 32` and copy the
# identical value into both files; mismatched secrets mean every token
# this relay receives fails verification.
CAPTURE_TOKEN_SECRET="CHANGE_ME_MUST_MATCH_THE_MAIN_PROCESSS_ENV"

# ---- Where this relay listens -------------------------------------------
# Bind address -- NOT the same thing as CAPTURE_RELAY_ADVERTISE_HOST/_PORT
# in the main process's .env.example (that's what capture:// URLs tell
# clients to *connect to*; this is what this process *binds*). 0.0.0.0
# listens on every interface.
CAPTURE_RELAY_LISTEN_HOST="0.0.0.0"
CAPTURE_RELAY_LISTEN_PORT="8001"
