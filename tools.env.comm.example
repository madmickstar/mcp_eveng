# Per-tool enable/disable configuration for mcp-eveng -- Community edition.
#
# For an EVE-NG PRO/Corporate server, use tools.env.pro.example instead:
# two tools here (export_node, share_lab) are PRO/Corporate-only features
# -- confirmed against EVE-NG's own official features-compare page, live
# testing, and direct manual testing against a real Community server (see
# the README's "PRO vs Community differences" section) -- and are disabled
# below since they can't do anything useful on Community. Every other line
# in this file is identical to tools.env.pro.example: confirmed via direct
# manual testing against a real Community server that adding a second
# admin user, adding a folder, and moving a lab into it all work
# normally -- an earlier version of this file incorrectly omitted the
# user-management tools on the assumption user administration wasn't
# supported on Community at all; that assumption was wrong, corrected here.
#
# Copy this file to `tools.env` (or point MCP_TOOLS_CONFIG_PATH at wherever
# you keep it) to control which tools this server advertises to a connected
# MCP client. Every tool the server can expose is listed below, one per
# line, set to either `enabled` or `disabled`.
#
# Any tool not listed here at all defaults to enabled. Any value other than
# `disabled` (case-insensitive) is treated as enabled, so a typo fails safe
# (the tool stays visible) rather than silently hiding something.
#
# The six user-management tools below are disabled by default -- even with
# no tools.env file present at all, on both editions -- since EVE-NG user
# administration is often not something you want exposed to an LLM by
# default, not because Community can't support it (it can -- see above).
# Set any of them to `enabled` here to turn it back on.
#
# delete_lab is also disabled by default on both editions -- unlike
# delete_folder/delete_lab_node/delete_lab_network (all still enabled),
# deleting an entire lab is a more severe, harder-to-recover-from action
# than deleting one thing inside it.

# -- System ---------------------------------------------------------------
get_status=enabled
list_node_templates=enabled
get_node_template=enabled
list_network_types=enabled
list_user_roles=disabled

# -- Server self-introspection ------------------------------------------------
list_tools=enabled

# -- Folders ----------------------------------------------------------------
list_folder=enabled
add_folder=enabled
move_folder=enabled
delete_folder=enabled

# -- Users (disabled by default -- see note above) ---------------------------
list_users=disabled
get_user=disabled
add_user=disabled
edit_user=disabled
delete_user=disabled

# -- Labs ---------------------------------------------------------------------
get_lab=enabled
open_lab=enabled
create_lab=enabled
edit_lab=enabled
share_lab=disabled  # PRO/Corporate-only -- see header note above. On Community, all labs are shared by default instead -- there's no per-lab sharing concept to toggle.
move_lab=enabled
delete_lab=disabled  # disabled by default -- deleting a whole lab is more severe than deleting one thing inside it
get_lab_topology=enabled
get_lab_links=enabled
list_lab_pictures=enabled
list_labs=enabled

# -- Lab networks -------------------------------------------------------------
list_lab_networks=enabled
add_lab_network=enabled
edit_lab_network=enabled
delete_lab_network=enabled

# -- Lab nodes ------------------------------------------------------------------
list_lab_nodes=enabled
add_lab_node=enabled
delete_lab_node=enabled
edit_lab_node=enabled
change_node_delay=enabled
edit_lab_nodes_by_template=enabled
get_node_interfaces=enabled
connect_interface=enabled
start_node=enabled
stop_node=enabled
wipe_node=enabled
export_node=disabled  # PRO/Corporate-only -- see header note above

# -- Link quality (PRO/Corporate only) -----------------------------------------
set_link_quality=disabled  # PRO/Corporate-only -- no Community equivalent at all
get_link_quality=disabled  # PRO/Corporate-only -- no Community equivalent at all

# -- Live console access -------------------------------------------------------
# telnet_node sends arbitrary CLI commands to a live running device's
# console, with no vendor-aware command-safety filtering -- a materially
# different risk profile than every other tool above, which only manage
# EVE-NG's own lab-topology metadata. Enabled by default like everything
# else here; set to `disabled` if you'd rather it be opt-in.
telnet_node=enabled

# -- Capture container listing/streaming (PRO/Corporate only) ------------------
# Not applicable on Community at all -- its own capture:// links already
# work unmodified via the GUI, no relay/SSH setup needed.
list_captures=disabled  # PRO/Corporate-only -- see header note above
get_capture=disabled  # PRO/Corporate-only -- see header note above
