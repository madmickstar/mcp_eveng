# Copy this file to `.env` and fill in your values. ONE shared .env file
# for BOTH the main mcp-eveng process and the standalone capture-relay
# service -- each reads only the settings it cares about (confirmed
# directly: every settings class here uses extra="ignore", so a
# variable neither app recognizes, or that belongs to the OTHER app, is
# silently skipped, not an error). Every variable is also settable as a
# real environment variable, which takes precedence over this file (see
# src/mcp_eveng/config.py).
#
# NOTE: which transport mcp-eveng speaks is a CLI flag, not a variable --
# run `mcp-eveng`, `mcp-eveng --sse`, or `mcp-eveng --http`. The MCP_*
# variables below are only read when you pass --sse or --http; in plain
# stdio mode (no flag) none of them are needed at all, because your MCP
# host (Claude Desktop, etc.) supplies EVENG_* directly in its own config
# instead of this file -- see README.md for that example.
#
# WINDOWS PATHS: for any *_PATH variable below, use forward slashes
# ("C:/path/to/file") instead of backslashes. A backslash immediately
# followed by certain letters (\t, \n, \r, and a few others) inside a
# DOUBLE-quoted value gets silently turned into an actual tab/newline/etc.
# character by this file's own parsing -- confirmed live: a path
# containing "\to\" or "\new..." breaks exactly this way, and the
# resulting error (deep inside OpenSSL, for TLS cert/key paths
# specifically) gives no hint that this is the real cause. This project
# now catches and clearly reports this specific corruption for every
# *_PATH variable, but forward slashes avoid it happening at all.

# ---- EVENG connection ---------------------------------------------------
# EVENG_HOST is an IP or hostname only (no scheme/port) -- port and
# protocol are separate variables below, so set all three to match your
# EVE-NG deployment.
EVENG_HOST="127.0.0.1"
EVENG_PORT="443"
EVENG_PROTOCOL="https"
EVENG_USERNAME="admin"
EVENG_PASSWORD="eve"

# "-1" = auto, "0" = HTML5/Pro only, "1" = native console (community default)
EVENG_HTML5="-1"

# Default is false, since EVE-NG (especially Pro) commonly uses a
# self-signed HTTPS certificate; set to true if your server has a valid cert.
EVENG_VERIFY_SSL="false"
EVENG_TIMEOUT_SECONDS="30"

# ---- MCP network transport (only used with --sse or --http) ------------
MCP_HOST="127.0.0.1"
MCP_PORT="8000"
MCP_HTTP_PATH="/mcp"
MCP_SSE_PATH="/sse"

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Always written to stderr --
# never stdout, since stdout carries the stdio JSON-RPC stream.
MCP_LOG_LEVEL="INFO"

# Required whenever MCP_HOST is not a loopback address (127.0.0.1/localhost/::1).
# Comma-separated Host-header allowlist for the SDK's DNS-rebinding
# protection. Each entry is "host:port" or "host:*" for any port. Default
# matches the default loopback MCP_HOST out of the box; if you change
# MCP_HOST to something else (e.g. 0.0.0.0), update this to match, e.g.:
# MCP_ALLOWED_HOSTS="localhost:*,192.168.10.100:*"
MCP_ALLOWED_HOSTS="localhost:*"

# true (default): streamable-http keeps session state between requests.
# false: disables session persistence, so a server restart doesn't leave
# clients holding a session id the server no longer recognizes.
MCP_STATEFUL="true"

# If set, every --sse/--http request must present it via
# "Authorization: Bearer <key>", or gets a 401. Unset (default): no
# API-key check at all -- only the Host-header allowlist above.
# MCP_API_KEY="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"

# Both required together, or leave both unset. Serves --sse/--http over
# HTTPS instead of plain HTTP when set. For a systemd deployment, see
# install-linux.md's systemd section step 5 for creating /etc/mcp-eveng
# with the right ownership/permissions before putting real files here.
# If MCP_TLS_CERT_PATH points at a combined server+CA cert file, the
# server cert must come FIRST, with the CA cert below it -- confirmed
# live, the reverse order fails with "key values mismatch" (the first
# cert in the file is what gets matched against the private key).
# MCP_TLS_CERT_PATH="/etc/mcp-eveng/cert.pem"
# MCP_TLS_KEY_PATH="/etc/mcp-eveng/key.pem"

# Only needed if the private key above is itself password-protected.
# MCP_TLS_KEY_PASSWORD="CHANGE_ME"

# ---- Capture relay: shared by mcp-eveng and mcp-relay (PRO only) -------
# CAPTURE_SSH_*/CAPTURE_TOKEN_SECRET below are read by BOTH the main
# mcp-eveng process (for list_captures/get_capture) AND the standalone
# capture-relay service -- one shared declaration each, not "must match
# across two files" the way it was when each process read a separate
# .env. See docs/capture-relay.md for the full setup.
#
# ONE shared SSH service account (`mcp-eveng`) is used by BOTH -- see
# docs/capture-relay.md for the two different *roles* that name covers
# (the account systemd runs these processes as, locally, vs. the account
# being SSH'd into on the EVE-NG host). See docs/capture-relay.md steps
# 1-4 for creating the EVE-NG-host account and scoping sudo rights.

# Same host as EVENG_HOST by default -- the docker containers this SSHes
# to reach run on the same EVE-NG server the REST API above talks to, in
# the overwhelming majority of setups. Override if yours genuinely
# differs (e.g. docker itself run from a different box than the EVE-NG
# API front-end).
CAPTURE_SSH_HOST="${EVENG_HOST}"
CAPTURE_SSH_PORT="22"
CAPTURE_SSH_USERNAME="mcp-eveng"

# The PRIVATE key, on THIS machine -- NOT a path on the EVE-NG host. Only
# this key's PUBLIC half needs to reach the EVE-NG host (into mcp-eveng's
# own authorized_keys there) -- see docs/capture-relay.md step 2.
CAPTURE_SSH_KEY_PATH="/home/youruser/.ssh/mcp-eveng-capture"

# Set this for anything beyond a lab -- unset disables SSH host-key
# checking entirely. For a systemd deployment, see install-linux.md's
# systemd section step 5 for creating /etc/mcp-eveng with the right
# ownership/permissions before putting a real file here.
# CAPTURE_SSH_KNOWN_HOSTS="/etc/mcp-eveng/known_hosts"
CAPTURE_SSH_TIMEOUT_SECONDS="15"

# The shared HMAC secret get_capture signs tokens with and mcp-relay
# verifies against -- generate once with `openssl rand -hex 32`.
CAPTURE_TOKEN_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"

# How long a get_capture URL/token stays valid. Short by design -- it's
# the only revocation mechanism there is. Only read by mcp-eveng.
CAPTURE_TOKEN_TTL_SECONDS="60"

# Where get_capture's returned capture:// URL tells the .bat companion to
# connect -- mcp-relay's externally-reachable address, NOT its bind
# address (that's CAPTURE_RELAY_LISTEN_HOST/_PORT below). Only read by
# mcp-eveng. NOT defaulted to EVENG_HOST like CAPTURE_SSH_HOST above --
# mcp-relay can genuinely run on a different machine from the EVE-NG
# server itself.
CAPTURE_RELAY_ADVERTISE_HOST="192.168.1.50"
CAPTURE_RELAY_ADVERTISE_PORT="8001"

# ---- Capture relay: mcp-relay's own settings ----------------------------
# Everything below is only read by the standalone mcp-eveng-capture-relay
# service, not by the main mcp-eveng process.

# Bind address -- NOT the same thing as CAPTURE_RELAY_ADVERTISE_HOST/_PORT
# above (that's what capture:// URLs tell clients to *connect to*; this
# is what mcp-relay *binds*). 0.0.0.0 listens on every interface.
CAPTURE_RELAY_LISTEN_HOST="0.0.0.0"
CAPTURE_RELAY_LISTEN_PORT="8001"

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Drives both mcp-relay's own
# log statements and uvicorn's own access/error logs.
CAPTURE_RELAY_LOG_LEVEL="INFO"

# Both required together, or leave both unset. Serves mcp-relay over
# HTTPS instead of plain HTTP when set. See install-linux.md's systemd
# section step 5 for creating /etc/mcp-eveng with the right
# ownership/permissions before putting real files here.
# If CAPTURE_RELAY_TLS_CERT_PATH points at a combined server+CA cert
# file, the server cert must come FIRST, with the CA cert below it --
# confirmed live, the reverse order fails with "key values mismatch"
# (the first cert in the file is what gets matched against the key).
# CAPTURE_RELAY_TLS_CERT_PATH="/etc/mcp-eveng/relay-cert.pem"
# CAPTURE_RELAY_TLS_KEY_PATH="/etc/mcp-eveng/relay-key.pem"

# Only needed if the private key above is itself password-protected.
# CAPTURE_RELAY_TLS_KEY_PASSWORD="CHANGE_ME"
