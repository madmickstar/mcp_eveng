# Per-tool enable/disable configuration for mcp-eveng.
#
# Copy this file to `tools.env` (or point MCP_TOOLS_CONFIG_PATH at wherever
# you keep it) to control which tools this server advertises to a connected
# MCP client. Every tool the server can expose is listed below, one per
# line, set to either `enabled` or `disabled`.
#
# Any tool not listed here at all defaults to enabled. Any value other than
# `disabled` (case-insensitive) is treated as enabled, so a typo fails safe
# (the tool stays visible) rather than silently hiding something.
#
# The six user-management tools below are disabled by default -- even with
# no tools.env file present at all -- since EVE-NG user administration is
# often not something you want exposed to an LLM by default. Set any of
# them to `enabled` here to turn it back on.

# -- System ---------------------------------------------------------------
get_status=enabled
list_node_templates=enabled
get_node_template=enabled
list_network_types=enabled
list_user_roles=disabled

# -- Server self-introspection ------------------------------------------------
list_tools=enabled

# -- Folders ----------------------------------------------------------------
list_folder=enabled
add_folder=enabled
move_folder=enabled
delete_folder=enabled

# -- Users (disabled by default -- see note above) ---------------------------
list_users=disabled
get_user=disabled
add_user=disabled
edit_user=disabled
delete_user=disabled

# -- Labs ---------------------------------------------------------------------
get_lab=enabled
open_lab=enabled
create_lab=enabled
edit_lab=enabled
share_lab=enabled
move_lab=enabled
delete_lab=enabled
get_lab_topology=enabled
get_lab_links=enabled
list_lab_pictures=enabled
list_labs=enabled

# -- Lab networks -------------------------------------------------------------
list_lab_networks=enabled
add_lab_network=enabled
edit_lab_network=enabled
delete_lab_network=enabled

# -- Lab nodes ------------------------------------------------------------------
list_lab_nodes=enabled
add_lab_node=enabled
delete_lab_node=enabled
edit_lab_node=enabled
change_node_delay=enabled
edit_lab_nodes_by_template=enabled
get_node_interfaces=enabled
connect_interface=enabled
start_node=enabled
stop_node=enabled
wipe_node=enabled
export_node=enabled

# -- Live console access -------------------------------------------------------
# telnet_node sends arbitrary CLI commands to a live running device's
# console, with no vendor-aware command-safety filtering -- a materially
# different risk profile than every other tool above, which only manage
# EVE-NG's own lab-topology metadata. Enabled by default like everything
# else here; set to `disabled` if you'd rather it be opt-in.
telnet_node=enabled
